[Unit]
Description=Linear workspace sync reconciliation
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/podman run --rm --pull=newer -v %C/linear-workspace-sync/config.toml:/app/config.toml:ro -v %S/lws-state:/app/state --env-file=%C/linear-workspace-sync/env ghcr.io/tinmarr/linear-workspace-sync:latest --config /etc/linear-workspace-sync/config.toml
Nice=10
PrivateTmp=true
ProtectSystem=full
UMask=0077

[Install]
WantedBy=default.target
