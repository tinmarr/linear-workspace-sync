[Unit]
Description=Linear workspace sync reconciliation
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/podman run --rm --pull=newer -v %E/linear-workspace-sync/config.toml:/app/config.toml:ro -v %S/linear-workspace-sync:/app/state --env-file=%E/linear-workspace-sync/env ghcr.io/tinmarr/linear-workspace-sync:latest

[Install]
WantedBy=default.target
